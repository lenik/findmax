#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"الاستخدام: findmax [خيار]... [ملف]...\n"
"البحث عن الملفات ذات القيم القصوى وفق المعايير المحددة.\n"
"السلوك الافتراضي: إظهار الأكبر/الأحدث أولاً (الأقصى أولاً).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "الخيارات:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "الدخول إلى المجلدات بشكل متكرر\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "الترتيب العادي (الأصغر/الأقدم أولاً)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "وقت الوصول\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "وقت تغيير البيانات الوصفية\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "وقت الملف (وقت التعديل)\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "اختيار الختم الزمني (atime/access/use، ctime/status،\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification، birth/إنشاء)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "حجم الملف\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "اسم الملف، الترتيب حسب الإعدادات المحلية الحالية\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "طباعة الملفات العادية فقط\n"

#: src/main.c:145
msgid "print directory only\n"
msgstr "طباعة المجلدات فقط\n"

#: src/main.c:147
msgid "output format\n"
msgstr "تنسيق الإخراج\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "إظهار أول NUM ملفات، الافتراضي 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "كرر للحصول على سجلات أكثر تفصيلاً\n"

#: src/main.c:153
msgid "show less logging messages\n"
msgstr "إظهار رسائل سجل أقل\n"

#: src/main.c:155
msgid "follow symbolic links\n"
msgstr "اتباع الروابط الرمزية\n"

#: src/main.c:157
msgid "limit directory traversal depth\n"
msgstr "تقييد عمق اجتياز المجلدات\n"

#: src/main.c:159
msgid "display this help and exit\n"
msgstr "عرض هذه المساعدة والخروج\n"

#: src/main.c:161
msgid "output version information and exit\n"
msgstr "عرض معلومات الإصدار والخروج\n"

#: src/main.c:163
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "الإبلاغ عن العلل إلى: <%s>\n"

