#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"사용법: findmax [옵션]... [파일]...\n"
"지정한 조건에서 최댓값인 파일을 찾습니다.\n"
"기본 동작: 가장 큰/최신 파일을 먼저 표시합니다(최대 우선).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "옵션:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "디렉터리를 재귀적으로 탐색\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "일반 순서(가장 작음/오래됨 우선)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "접근 시간\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "메타데이터 변경 시간\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "파일 시간(수정 시간)\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "타임스탬프 선택(atime/access/use, ctime/status,\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification, birth/생성)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "파일 크기\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "파일 이름, 현재 로케일 순서\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "일반 파일만 출력\n"

#: src/main.c:145
msgid "print directory only\n"
msgstr "디렉터리만 출력\n"

#: src/main.c:147
msgid "output format\n"
msgstr "출력 형식\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "상위 NUM개 파일 표시, 기본값 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "반복하면 로그가 더 상세해짐\n"

#: src/main.c:153
msgid "show less logging messages\n"
msgstr "로그 메시지를 줄임\n"

#: src/main.c:155
msgid "follow symbolic links\n"
msgstr "심볼릭 링크를 따라감\n"

#: src/main.c:157
msgid "limit directory traversal depth\n"
msgstr "디렉터리 탐색 깊이 제한\n"

#: src/main.c:159
msgid "display this help and exit\n"
msgstr "이 도움말을 표시하고 종료\n"

#: src/main.c:161
msgid "output version information and exit\n"
msgstr "버전 정보를 표시하고 종료\n"

#: src/main.c:163
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "버그 보고: <%s>\n"

