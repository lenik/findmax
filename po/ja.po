#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"使い方: findmax [オプション]... [ファイル]...\n"
"指定した条件で最大値を持つファイルを検索します。\n"
"既定の動作: 最大/最新のファイルを先に表示します（最大優先）。\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "オプション:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "ディレクトリを再帰的に探索する\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "通常順（最小/最古を先に）\n"

#: src/main.c:129
msgid "access time\n"
msgstr "アクセス時刻\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "メタデータ変更時刻\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "ファイル時刻（更新時刻）\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "タイムスタンプを選択 (atime/access/use, ctime/status,\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification、birth/creation)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "ファイルサイズ\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "ファイル名、現在のロケール順\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "通常ファイルのみ表示\n"

#: src/main.c:145
msgid "print directory only\n"
msgstr "ディレクトリのみ表示\n"

#: src/main.c:147
msgid "output format\n"
msgstr "出力形式\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "上位 NUM 件を表示、既定は 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "繰り返すとより詳細なログ\n"

#: src/main.c:153
msgid "show less logging messages\n"
msgstr "ログメッセージを減らす\n"

#: src/main.c:155
msgid "follow symbolic links\n"
msgstr "シンボリックリンクをたどる\n"

#: src/main.c:157
msgid "limit directory traversal depth\n"
msgstr "ディレクトリ探索の深さを制限\n"

#: src/main.c:159
msgid "display this help and exit\n"
msgstr "このヘルプを表示して終了\n"

#: src/main.c:161
msgid "output version information and exit\n"
msgstr "バージョン情報を表示して終了\n"

