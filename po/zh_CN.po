#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"用法：findmax [选项]... [文件]...\n"
"按指定条件查找具有最大值的文件。\n"
"默认行为：优先显示最大/最新的文件（最大值优先）。\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "选项：\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "递归进入目录\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "正常顺序（最小/最旧优先）\n"

#: src/main.c:129
msgid "access time\n"
msgstr "访问时间\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "元数据更改时间\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "文件时间（修改时间）\n"

#: src/main.c:135
