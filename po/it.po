#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"Uso: findmax [OPZIONE]... [FILE]...\n"
"Trova i file con i valori massimi per i criteri specificati.\n"
"Comportamento predefinito: mostra prima i più grandi/più recenti (max per primi).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "Opzioni:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "entra ricorsivamente nelle directory\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "ordine normale (più piccolo/più vecchio per primo)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "ora di accesso\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "ora di modifica dei metadati\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "ora del file (modifica)\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "seleziona timestamp (atime/access/use, ctime/status,\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification, birth/creazione)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "dimensione del file\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "nome file, ordine secondo la locale corrente\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "stampa solo file regolari\n"

#: src/main.c:145
msgid "print directory only\n"
msgstr "stampa solo directory\n"

#: src/main.c:147
msgid "output format\n"
msgstr "formato di output\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "mostra i primi NUM file, predefinito 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "ripetere per registrazioni più dettagliate\n"

#: src/main.c:153
msgid "show less logging messages\n"
msgstr "mostra meno messaggi di registro\n"

#: src/main.c:155
msgid "follow symbolic links\n"
msgstr "segui i collegamenti simbolici\n"

#: src/main.c:157
msgid "limit directory traversal depth\n"
msgstr "limita la profondità di attraversamento\n"

#: src/main.c:159
msgid "display this help and exit\n"
msgstr "mostra questo aiuto ed esci\n"

#: src/main.c:161
