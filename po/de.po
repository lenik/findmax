#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"Aufruf: findmax [OPTION]... [DATEI]...\n"
"Dateien mit Maximalwerten für angegebene Kriterien finden.\n"
"Standardverhalten: größte/neueste Dateien zuerst anzeigen (Max zuerst).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "Optionen:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "rekursiv in Verzeichnisse gehen\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "normale Reihenfolge (kleinste/älteste zuerst)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "Zugriffszeit\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "Metadaten-Änderungszeit\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "Dateizeit (Änderungszeit)\n"

#: src/main.c:135
