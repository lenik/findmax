#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"Uso: findmax [OPCIÓN]... [ARCHIVO]...\n"
"Busca archivos con valores máximos para los criterios indicados.\n"
"Comportamiento predeterminado: mostrar primero los más grandes/recientes (máx primero).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "Opciones:\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "entrar recursivamente en directorios\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "orden normal (más pequeño/antiguo primero)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "hora de acceso\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "hora de cambio de metadatos\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "hora del archivo (modificación)\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "elegir marca de tiempo (atime/access/use, ctime/status,\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification, birth/creación)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "tamaño del archivo\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "nombre de archivo, orden según la configuración regional\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "mostrar solo archivos normales\n"

#: src/main.c:145
msgid "print directory only\n"
msgstr "mostrar solo directorios\n"

#: src/main.c:147
msgid "output format\n"
msgstr "formato de salida\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "mostrar los NUM primeros archivos, predeterminado 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "repetir para registros más detallados\n"

#: src/main.c:153
msgid "show less logging messages\n"
msgstr "mostrar menos mensajes de registro\n"

#: src/main.c:155
msgid "follow symbolic links\n"
msgstr "seguir enlaces simbólicos\n"

#: src/main.c:157
msgid "limit directory traversal depth\n"
msgstr "limitar la profundidad de recorrido\n"

#: src/main.c:159
msgid "display this help and exit\n"
msgstr "mostrar esta ayuda y salir\n"

#: src/main.c:161
msgid "output version information and exit\n"
msgstr "mostrar la información de versión y salir\n"

