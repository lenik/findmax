#: src/main.c:118
msgid ""
"Usage: findmax [OPTION]... [FILE]...\n"
"Find files with maximum values for specified criteria.\n"
"Default behavior: show largest/newest files first (max-first).\n"
msgstr ""
"Utilisation : findmax [OPTION]... [FICHIER]...\n"
"Trouver les fichiers ayant les valeurs maximales pour les critères indiqués.\n"
"Comportement par défaut : afficher d'abord les plus grands/plus récents (max en premier).\n"

#: src/main.c:123
msgid "Options:\n"
msgstr "Options :\n"

#: src/main.c:125
msgid "recursive into directories\n"
msgstr "parcourir les répertoires récursivement\n"

#: src/main.c:127
msgid "normal order (smallest/oldest first)\n"
msgstr "ordre normal (plus petit/plus ancien d'abord)\n"

#: src/main.c:129
msgid "access time\n"
msgstr "heure d'accès\n"

#: src/main.c:131
msgid "metadata change time\n"
msgstr "heure de changement des métadonnées\n"

#: src/main.c:133
msgid "file time (modification time)\n"
msgstr "heure du fichier (modification)\n"

#: src/main.c:135
msgid "select timestamp (atime/access/use, ctime/status,\n"
msgstr "choisir l'horodatage (atime/access/use, ctime/status,\n"

#: src/main.c:137
msgid "mtime/modification, birth/creation)\n"
msgstr "mtime/modification, birth/création)\n"

#: src/main.c:139
msgid "file size\n"
msgstr "taille du fichier\n"

#: src/main.c:141
msgid "file name, order in current locale setting\n"
msgstr "nom de fichier, ordre selon la locale courante\n"

#: src/main.c:143
msgid "print plain file only\n"
msgstr "afficher uniquement les fichiers ordinaires\n"

#: src/main.c:145
msgid "print directory only\n"
