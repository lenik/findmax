#: src/main.c:147
msgid "output format\n"
msgstr "format de sortie\n"

#: src/main.c:149
msgid "show top NUM files, default 1\n"
msgstr "afficher les NUM premiers fichiers, défaut 1\n"

#: src/main.c:151
msgid "repeat for more verbose loggings\n"
msgstr "répéter pour plus de messages de journal\n"

#: src/main.c:153
